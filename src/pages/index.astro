---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import HowItWorks from '~/components/widgets/HowItWorks.astro';
import SCF from '~/components/widgets/SCF.astro';
import ContactForm from '~/components/widgets/ContactForm.astro';

import Button from '~/components/ui/Button.astro';
import SpiralGraphic from '~/components/ui/SpiralGraphic.astro';

import logo from '~/assets/recursos/logo/EvolvIA-2.png';
import heroBgLogo from '~/assets/recursos/fondos/logoBG.png';
import heroBgHero from '~/assets/recursos/fondos/Hero.png';
import featuresBg from '~/assets/recursos/fondos/que_es.png';

const metadata = {
  title: 'EvolvIA — Ventures',
  ignoreTitleTemplate: true,
};

const WA = 'https://wa.me/573043758478?text=Hola%20EvolvIA%2C%20quiero%20iniciar%20mi%20camino%20estrat%C3%A9gico';
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'evolviaPrimary',
        text: 'Inicia tu camino estratégico',
        href: WA,
        target: '_blank',
        class: 'btn-hero-v2',
      },
    ]}
   headlineClasses={{
    title: 'text-2xl md:text-4xl font-semibold tracking-tight font-heading mb-8'
  }}
>
  
    <!-- Fondo general del Hero -->
    <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-cover bg-center opacity-55 brightness-90"
        style={`background-image: url(${heroBgHero.src});`}
      >
      </div>
    </Fragment>

 <Fragment slot="image">
  <!-- wrapper full-bleed -->
  <div class="relative w-screen max-w-none aspect-[2/1] left-1/2 right-1/2 -mx-[50vw]">
    <!-- Fondo ocupa todo el viewport -->
    <img
      src={heroBgLogo.src ?? heroBgLogo}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
    />

    <!-- Logo centrado sobre el fondo -->
    <img
      src={logo.src ?? logo}
      alt="EvolvIA Logo"
      class="relative z-10 h-auto w-[40%] sm:w-[30%] md:w-[20%] mx-auto block"
    />
  </div>
</Fragment>




    <!-- Título -->
    <Fragment slot="title">
    <span class="font-heading">
      Bienvenido a <span class="dark:text-white">Evolv<strong>IA</strong></span>
    </span>
  </Fragment>

    <!-- Subtítulo -->
    <Fragment slot="subtitle">
      Diseñamos y acompañamos procesos de transformación profunda desde una arquitectura híbrida de inteligencia humana
      y simbiótica.
      <span class="block mt-4 text-2xl font-bold text-black dark:text-white">
        No vendemos soluciones. <span class="">Activamos saltos evolutivos.</span>
      </span>
    </Fragment>

    <!-- Texto de apoyo -->
    <Fragment slot="content">
      <p class="text-emerald mt-2 italic text-primary text-center text-lg">
        Descubre lo que tu organización ya está diciendo, aunque aún no tenga forma.
      </p>
    </Fragment>
  </Hero>

  <!-- ¿Qué es EvolvIA? -->
  <section id="features" class="relative text-white w-full mx-auto px-4 md:px-6 py-12 md:py-16 lg:py-20">
    <!-- Fondo -->
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url(${featuresBg.src});`}></div>

    <!-- Overlay oscuro -->
    <div class="absolute inset-0 bg-black/25"></div>

    <!-- Contenido por encima del fondo -->
    <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- A -->
      <div class="col-span-1 flex flex-col items-center justify-center">
        <p class="text-primary font-bold uppercase mb-4 text-lg md:text-xl">¿Qué es?</p>
        <h2 class="text-6xl md:text-7xl font-heading font-bold">Evolv<strong>IA</strong></h2>
      </div>

      <!-- B -->
      <div class="col-span-1 md:col-span-2 border-l border-gray-500 pl-8">
        <h3 class="text-primary text-3xl font-bold mb-4">
          EvolvIA no es una herramienta ni una consultora tradicional.
        </h3>
        <p class="mb-4 text-lg">
          Es un sistema vivo que integra funciones cognitivas activas —<em><strong>humanas y artificiales</strong></em>—
          para ayudar a las organizaciones a evolucionar con coherencia, estrategia y sentido.
        </p>
        <h4 class="text-2xl font-bold">Trabajamos en red, no en jerarquía</h4>
        <p class="text-primary text-lg">Desde la tensión real de cada organización, no desde recetas.</p>
      </div>

      <!-- C -->
      <div class="col-span-1 md:col-span-3 mt-8 flex flex-col items-center">
        <Button variant="discover" class="md:px-12" text="Descubre EvolvIA" href={WA} target="_blank" />

        <p class="text-primary mt-5 italic text-center text-lg">
          Descubre lo que tu organización ya está diciendo, aunque aún no tenga forma.
        </p>
      </div>
    </div>
  </section>

  <!-- ¿Qué hacemos? -->
  <Features2
    subtitle=""
    items={[
      {
        title: 'Diagnóstico vivo del momento organizacional',
        description: '',
        // icon: 'flat-color-icons:template',
      },
      {
        title: 'Rediseño estructural y adaptativo',
        description: '',
        // icon: 'flat-color-icons:gallery',
      },
      {
        title: 'Acompañamiento estratégico en procesos de cambio',
        description: '',
        // icon: 'flat-color-icons:approval',
      },
      {
        title: 'Activación de equipos con propósito',
        description: '',
        // icon: 'flat-color-icons:document',
      },
      {
        title: 'Diseño de narrativa estratégica y posicionamiento',
        description: '',
        // icon: 'flat-color-icons:advertising',
      },
      {
        title: 'Lectura evolutiva del entorno y mercado',
        description: '',
        // icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'Escalamiento con sentido y coherencia',
        description: '',
        // icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'Cuidado profundo de la cultura y el clima',
        description: '',
        // icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'Alineación entre propósito, personas y procesos',
        description: '',
        // icon: 'flat-color-icons:database',
      },
    ]}
  >
    <!-- Título personalizado con color institucional -->
    <Fragment slot="title">
      <h2 class="text-primary text-4xl font-heading font-bold text-center">¿Qué hacemos?</h2>
    </Fragment>

    <!-- Fondo con "emerald" -->
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-page-features2 dark:bg-transparent"></div>
    </Fragment>

    <!-- Botón llamado a la acción -->
    <Fragment slot="content">
      <div class="mt-8 text-center">
        <Fragment slot="content">
          <div class="mt-8 text-center">
            <Button text="Activemos la conversación" href={WA} target="_blank" variant="primary" />
          </div>
        </Fragment>
      </div>
    </Fragment>

    <Fragment slot="content">
      <p class="text-emerald mt-5 italic text-primary text-center text-lg">
        Descubre lo que tu organización ya está diciendo, aunque aún no tenga forma.
      </p>
    </Fragment>
  </Features2>

  <!-- 
  Prop: isReversed
  Función: invierte el orden de imagen y contenido en pantallas ≥ md
-->

  <Content
    isAfterContent
    isReversed={true}
    items={[
      {
        title: '- No creemos en fórmulas, <b>creamos condiciones</b>.',
      },
      {
        title: '- Donde otros trazan planes, <b>nosotros cultivamos presencia.</b>',
      },
      {
        title: '- No dirigimos, <b>acompañamos lo que quiere emerger.</b>',
      },
      {
        title: '- Transformar no es ejecutar, <b>es orquestar sentido.</b>',
      },
      {
        title: '- Las organizaciones no se gestionan, <b>se escuchan.</b>',
      },
    ]}
    classes={{
      container: 'md:flex md:gap-16 relative text-white font-sans',
      title: 'text-white',
      description: 'text-white',
    }}
  >
    <!-- Fondo con imagen + overlay -->
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url(${featuresBg.src});`}></div>
      <div class="absolute inset-0 bg-black/40"></div>
    </Fragment>

    <!-- Spiral -->
    <Fragment slot="image">
      <div class="max-w-md mx-auto">
        <SpiralGraphic />
      </div>
    </Fragment>

    <!-- callToAction -->
    <Fragment slot="cta">
      <CallToAction
        actions={[
          {
            variant: 'primary',
            text: '¡Activa una conversación viva!',
            href: WA,
            target: '_blank',
            class: 'px-1 py-1 text-sm rounded-full',
          },
        ]}
      />
    </Fragment>
  </Content>

  <!-- ¿Cómo opera? -->
  <div class="relative">
    <!-- Fondo Hero.png con filtros -->
    <div
      class="absolute inset-0 bg-cover bg-center opacity-50 brightness-90"
      style={`background-image: url(${heroBgHero.src});`}
    >
    </div>

    <!-- Contenido siempre por encima -->
    <div class="relative z-10">
      <HowItWorks />
    </div>
  </div>

  <!-- SCF: Funciones Cognitivas Simbióticas -->
  <SCF />

  <!-- Formulario de Contacto -->
  <ContactForm id="contacto" />
</Layout>
