---
import { twMerge } from 'tailwind-merge';

const {
  variant = 'secondary',
  target,
  text = Astro.slots.render('default'),
  class: className = '',
  type,
  ...rest
} = Astro.props;

/**
 * OBJETIVO (provisional):
 * - Neutralizar TODOS los estilos de variantes (sin tokens, sin clases globales de AstroWind).
 * - Mantener la API (mismas variantes) para que luego, cuando llegue el SVG,
 *   sólo modifiquemos aquí (p.ej., en `evolviaPrimary`) sin tocar llamadas.
 */

// 1) Base neutra (no usa variables de marca, ni clases de la plantilla)
const baseNeutral =
  [
    'inline-flex items-center justify-center gap-2',
    'px-5 py-2.5 rounded-md',
    'border border-neutral-300 bg-white text-neutral-900 no-underline',
    'transition-colors duration-150',
    'hover:bg-neutral-50',
    'focus:outline-none focus-visible:ring-4 focus-visible:ring-neutral-300/60',
    'disabled:opacity-50 disabled:pointer-events-none',
    'active:translate-y-[0.5px]',
    'whitespace-nowrap',
  ].join(' ');

// 2) Variantes “apagadas”: dejamos las claves por compatibilidad, pero sin estilos propios
const variants = {
  primary: '',
  secondary: '',
  tertiary: '',
  link: '',

  // EvolvIA (todas apagadas, incl. el Hero)
  Hero: '',
  outline: '',
  emerald: '',
  ghost: '',
  linkCta: '',
  ticket: '',
  discover: '',
};

// 3) Clase final (si una variante trae clases, se fusionan; ahora todas están vacías a propósito)
const computedClass = twMerge(baseNeutral, variants[variant] || '', className);

// 4) Render conserva la lógica <button> vs <a>
const isButtonTag = type === 'button' || type === 'submit' || type === 'reset';
---

{isButtonTag ? (
  <button type={type} class={computedClass} {...rest}>
    <Fragment set:html={text} />
  </button>
) : (
  <a
    class={computedClass}
    {...(target ? { target, rel: 'noopener noreferrer' } : {})}
    {...rest}
  >
    <Fragment set:html={text} />
  </a>
)}
