---
import { twMerge } from 'tailwind-merge';

// SVG local (como URL para background-image)
import heroSkin from '~/assets/recursos/buttons/Hero.svg?url';

const {
  text = Astro.slots.render('default'),
  class: className = '',
  type,
  target,
  // ajusta al viewBox real de tu SVG: "ancho/alto"
  aspect="1280/320",
  ...rest
} = Astro.props;

// ÚNICA apariencia: nodo clicable con el SVG de fondo
const base = [
  'relative block select-none cursor-pointer',
  'w-[640px] max-w-[92vw]',
  // reserva altura con aspect-ratio
  `aspect-[${aspect}]`,
  // pinta el SVG sin distorsión
  'bg-no-repeat bg-contain bg-center',
  // centra el texto
  'grid place-items-center px-4 text-center',
  // accesibilidad
  'focus:outline-none focus-visible:ring-4 focus-visible:ring-neutral-300/60',
].join(' ');

const computedClass = twMerge(base, className);
const bgStyle = `background-image: url(${heroSkin});`

const isButtonTag = type === 'button' || type === 'submit' || type === 'reset';
---

{isButtonTag ? (
  <button type={type} class={computedClass} style={bgStyle} {...rest}>
    <span class="font-semibold leading-none text-white text-[clamp(14px,2.6vw,18px)]">
      <Fragment set:html={text} />
    </span>
  </button>
) : (
  <a
    class={computedClass}
    style={bgStyle}
    {...(target ? { target, rel: 'noopener noreferrer' } : {})}
    {...rest}
  >
    <span class="font-semibold leading-none text-white text-[clamp(14px,2.6vw,18px)]">
      <Fragment set:html={text} />
    </span>
  </a>
)}
