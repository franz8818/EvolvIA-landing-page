---
import { twMerge } from 'tailwind-merge';

// === SKIN ACTIVO (solo HERO) ===
import heroSkin from '~/assets/recursos/buttons/Hero.svg?url';

const {
  // Contenido
  text = Astro.slots.render('default'),

  // HTML
  class: className = '',
  type,                // 'button' | 'submit' | 'reset' (si no, renderiza <a>)
  target,

  // Control (layout/skin)
  width = 1800,        // informativo para futuras mejoras
  maxWidth = 1100,     // tope absoluto px (útil en 1280×720)
  aspect = '1280/360', // un poco más alto que 4:1 para dar aire al texto
  scale = 1.08,        // zoom sutil del SVG (1.00–1.08 recomendado)

  // Texto
textClass="text-black",
textSize="text-[40px]",

  // Anchos responsivos (min(vw, maxWidth))
  xsMax = 92, // <640px
  smMax = 88, // ≥640px
  mdMax = 72, // ≥768px
  lgMax = 64, // ≥1024px
  xlClampPx = 1100, // ≥1280px — ancla ideal p/ monitor 1280×720

  ...rest
} = Astro.props;

// === SKIN URL ===
const skinURL = heroSkin;

// Wrapper base
const base = [
  'relative grid place-items-center text-center select-none cursor-pointer shrink-0',
  'overflow-visible',
  'focus:outline-none focus-visible:ring-4 focus-visible:ring-neutral-300/60',
].join(' ');

// width = min(Xvw, var(--btn-mw))
const widthClasses = [
  `w-[min(${xsMax}vw,var(--btn-mw))]`,
  `sm:w-[min(${smMax}vw,var(--btn-mw))]`,
  `md:w-[min(${mdMax}vw,var(--btn-mw))]`,
  `lg:w-[min(${lgMax}vw,var(--btn-mw))]`,
  `xl:w-[min(${xlClampPx}px,var(--btn-mw))]`,
].join(' ');

const computedClass = twMerge(base, widthClasses, className);
const isButtonTag = type === 'button' || type === 'submit' || type === 'reset';

// Inline style: precisión total para ratio y tope
const wrapperStyle =
  `--btn-w:${width}px;` +
  `--btn-mw:${maxWidth}px;` +
  `aspect-ratio:${aspect.replace('/', ' / ')};`;
---

{isButtonTag ? (
  <button type={type} class={computedClass} style={wrapperStyle} {...rest}>
    <img
      src={skinURL}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-contain pointer-events-none"
      style={`transform:scale(${scale});transform-origin:center;`}
    />
    <span
      class={`relative z-10 font-semibold leading-none btn-text-nowrap ${textSize} ${textClass}`}
      style="white-space:nowrap; word-break:keep-all; hyphens:none; -webkit-hyphens:none; -ms-hyphens:none; display:inline-block;"
    >
      <Fragment set:html={text} />
    </span>
  </button>
) : (
  <a
    class={computedClass}
    style={wrapperStyle}
    {...(target ? { target, rel: 'noopener noreferrer' } : {})}
    {...rest}
  >
    <img
      src={skinURL}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-contain pointer-events-none"
      style={`transform:scale(${scale});transform-origin:center;`}
    />
    <span
      class={`relative z-10 font-semibold leading-none btn-text-nowrap ${textSize} ${textClass}`}
      style="white-space:nowrap; word-break:keep-all; hyphens:none; -webkit-hyphens:none; -ms-hyphens:none; display:inline-block;"
    >
      <Fragment set:html={text} />
    </span>
  </a>
)}
