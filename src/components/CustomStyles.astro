---
import '@fontsource-variable/inter';
---

<style is:inline>
  /* -------------------------------
   ✅ FUENTES PRINCIPALES
  ---------------------------------*/
  :root {
    --aw-font-sans: 'Montserrat';
    --aw-font-serif: 'Montserrat';
    --aw-font-heading: 'weezerfont'; /* Tu tipografía especial para headings */

    /* -------------------------------
      ✅ COLORES PRINCIPALES Y BOTONOS - MODO CLARO
     ---------------------------------*/
    --aw-color-primary: #00cfe5;       /* Color principal: botones, enlaces destacados */
    --aw-color-secondary: #f628a7;     /* Color secundario: hover, enlaces secundarios */
    --aw-color-accent: rgb(109 40 217); /* detalles visuales: borde, esquinas, líneas, efectos tech. */
    --aw-color-emerald: #0b7069; /* Botón tipo esmeralda */

    /* -------------------------------
      ✅ COLORES DE TEXTO Y FONDOS - MODO CLARO
     ---------------------------------*/
    --aw-color-text-heading: rgb(0 0 0);               /* Títulos en claro */
    --aw-color-text-default: rgb(16 16 16);            /* Texto principal */
    --aw-color-text-muted: rgb(16 16 16 / 66%);        /* Texto más suave */
    --aw-color-bg-page: rgb(255 255 255);              /* Fondo de la página */
    --aw-color-bg-page-dark: #111827;                  /* Fondo degradado gris */
    --aw-color-page-features2: #03292c;                /* Fondo sección Features2 */
    --aw-color-page-features2-dark: #021e22;           /* Fondo "tarjetas" Features2 */

    /* Color para selección de texto */
    ::selection {
      background-color: lavender;
    }
  }

  /* -------------------------------
    ✅ MODO OSCURO
  ---------------------------------*/
  .dark {
    --aw-font-sans: 'Montserrat';
    --aw-font-serif: 'Montserrat';
    --aw-font-heading: 'weezerfont';

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(247 248 248);         /* Títulos en oscuro */
    --aw-color-text-default: rgb(229 236 246);         /* Texto principal oscuro */
    --aw-color-text-muted: rgb(229 236 246 / 66%);     /* Texto suave oscuro */
    --aw-color-bg-page: rgb(3 6 32);                   /* Fondo en oscuro */

    ::selection {
      background-color: black;
      color: snow;
    }
  }

  /* -------------------------------
    ✅ FUENTE PERSONALIZADA
  ---------------------------------*/
  @font-face {
    font-family: 'weezerfont';
    src: url('/fonts/weezerfont.ttf') format('truetype');
    font-weight: normal; /* Sólo soporta 400 */
    font-style: normal;
  }

/* ===========================
   BTN HERO — skin v2 (pure CSS)
   - fondo cian
   - biseles amplios
   - “circuito” magenta arriba izq / abajo der
   - filete superior derecho
   - barra punteada derecha con remate magenta
   - puntitos decorativos
=========================== */
.btn-hero-v2{
  --c: var(--aw-color-primary, #00e8ee);   /* cian */
  --m: var(--aw-color-secondary, #f628a7); /* magenta */
  --ink: #0b1320;
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;

  color: var(--ink);
  font-weight: 800;
  letter-spacing: -.01em;

  /* base */
  background: var(--c);
  /* biseles (algo más grandes que v1) */
  clip-path: polygon(22px 0, 100% 0, 100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%, 0 22px);

  /* ritmo */
  transition: transform .15s ease, filter .15s ease;
}
.btn-hero-v2:hover{ transform: translateY(-1px); filter: brightness(1.02); }
.btn-hero-v2:active{ transform: translateY(0); filter: none; }

/* Capa de “circuito” y filetes (magenta) */
.btn-hero-v2::before{
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;

  /* múltiples layers posicionados */
  background:
    /* ── esquina sup-izq: tramo horizontal largo + “codo” + tramo vertical */
    linear-gradient(90deg,var(--m),var(--m)) top 10px left 40px/130px 3px no-repeat,
    linear-gradient(var(--m),var(--m))        top 10px left 28px/3px 26px no-repeat,
    linear-gradient(135deg,var(--m),var(--m)) top 15px left 15px/22px 3px no-repeat,

    /* ── esquina inf-der: tramo horizontal base + “codo” + tramo vertical */
    linear-gradient(90deg,var(--m),var(--m)) bottom 10px right 40px/130px 3px no-repeat,
    linear-gradient(var(--m),var(--m))        bottom 10px right 28px/3px 26px no-repeat,
    linear-gradient(-45deg,var(--m),var(--m)) bottom 15px right 15px/22px 3px no-repeat,

    /* ── filete superior derecho largo del arte */
    linear-gradient(90deg,var(--m),var(--m)) top 16px right 56px/190px 3px no-repeat;
}

/* Puntitos + barra punteada derecha */
.btn-hero-v2::after{
  content:'';
  position: absolute;
  inset: 0;
  pointer-events: none;

  background:
    /* puntitos magenta top-left (en diagonal leve) */
    radial-gradient(circle 1.5px at 172px 14px, var(--m) 99%, transparent 100%) no-repeat,
    radial-gradient(circle 1.5px at 180px 14px, var(--m) 99%, transparent 100%) no-repeat,
    radial-gradient(circle 1.5px at 188px 14px, var(--m) 99%, transparent 100%) no-repeat,

    /* puntitos magenta bottom-right */
    radial-gradient(circle 1.5px at calc(100% - 92px) calc(100% - 14px), var(--m) 99%, transparent 100%) no-repeat,
    radial-gradient(circle 1.5px at calc(100% - 84px) calc(100% - 14px), var(--m) 99%, transparent 100%) no-repeat,
    radial-gradient(circle 1.5px at calc(100% - 76px) calc(100% - 14px), var(--m) 99%, transparent 100%) no-repeat,

    /* barra punteada cian clara */
    repeating-linear-gradient(
      to right,
      color-mix(in oklab, var(--c), white 35%) 0 6px,
      transparent 6px 12px
    ) calc(100% - 250px) 50%/220px 3px no-repeat,

    /* remate magenta al final */
    linear-gradient(90deg,var(--m),var(--m)) calc(100% - 30px) 50%/20px 3px no-repeat;
}

/* Tamaños “Hero” por defecto; puedes sobre-escribir con Tailwind donde lo uses */
.btn-hero-v2 {
  padding: .9rem 2rem;
  font-size: clamp(1.05rem, 1.65vw, 1.45rem);
}
@media (min-width: 768px){
  .btn-hero-v2{ padding: 1.15rem 3.5rem; }
}

</style>
