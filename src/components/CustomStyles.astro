---
import '@fontsource-variable/inter';
---

<style is:inline>
  /* -------------------------------
   ✅ FUENTES PRINCIPALES
  ---------------------------------*/
  :root {
    --aw-font-sans: 'Montserrat';
    --aw-font-serif: 'Montserrat';
    --aw-font-heading: 'weezerfont'; /* Tu tipografía especial para headings */

    /* -------------------------------
      ✅ COLORES PRINCIPALES Y BOTONOS - MODO CLARO
     ---------------------------------*/
    --aw-color-primary: #00cfe5;       /* Color principal: botones, enlaces destacados */
    --aw-color-secondary: #f628a7;     /* Color secundario: hover, enlaces secundarios */
    --aw-color-accent: rgb(109 40 217); /* detalles visuales: borde, esquinas, líneas, efectos tech. */
    --aw-color-emerald: #0b7069; /* Botón tipo esmeralda */

    /* -------------------------------
      ✅ COLORES DE TEXTO Y FONDOS - MODO CLARO
     ---------------------------------*/
    --aw-color-text-heading: rgb(0 0 0);               /* Títulos en claro */
    --aw-color-text-default: rgb(16 16 16);            /* Texto principal */
    --aw-color-text-muted: rgb(16 16 16 / 66%);        /* Texto más suave */
    --aw-color-bg-page: rgb(255 255 255);              /* Fondo de la página */
    --aw-color-bg-page-dark: #111827;                  /* Fondo degradado gris */
    --aw-color-page-features2: #03292c;                /* Fondo sección Features2 */
    --aw-color-page-features2-dark: #021e22;           /* Fondo "tarjetas" Features2 */

    /* Color para selección de texto */
    ::selection {
      background-color: lavender;
    }
  }

  /* -------------------------------
    ✅ MODO OSCURO
  ---------------------------------*/
  .dark {
    --aw-font-sans: 'Montserrat';
    --aw-font-serif: 'Montserrat';
    --aw-font-heading: 'weezerfont';

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(247 248 248);         /* Títulos en oscuro */
    --aw-color-text-default: rgb(229 236 246);         /* Texto principal oscuro */
    --aw-color-text-muted: rgb(229 236 246 / 66%);     /* Texto suave oscuro */
    --aw-color-bg-page: rgb(3 6 32);                   /* Fondo en oscuro */

    ::selection {
      background-color: black;
      color: snow;
    }
  }

  /* -------------------------------
    ✅ FUENTE PERSONALIZADA
  ---------------------------------*/
  @font-face {
    font-family: 'weezerfont';
    src: url('/fonts/weezerfont.ttf') format('truetype');
    font-weight: normal; /* Sólo soporta 400 */
    font-style: normal;
  }

  /* ===========================
   Botón tipo "ticket" (antes btn-alive)
   100% CSS (sin spans auxiliares)
=========================== */
.btn-ticket{
  --primary: var(--aw-color-primary, #00cfe5);
  --ink: var(--aw-color-text-default, #101010);
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  border-radius: 1rem; /* ~rounded-2xl */
  background: linear-gradient(180deg,
    color-mix(in oklab, var(--primary), white 15%),
    var(--primary));
  box-shadow:
    0 8px 24px color-mix(in oklab, var(--primary), transparent 70%),
    inset 0 0 0 2px color-mix(in oklab, var(--primary), #000 15%);
  transition: transform .15s ease;
}
.btn-ticket::before,
.btn-ticket::after{
  content: '';
  position: absolute;
  left: 8px;
  right: 8px;
  height: 3px;
  border-radius: 999px;
  background: var(--primary);
  filter: drop-shadow(0 0 8px color-mix(in oklab, var(--primary), transparent 30%));
}
.btn-ticket::before{ top: -7px; }
.btn-ticket::after { bottom: -7px; }

.btn-ticket:hover{ transform: translateY(-1px); }
.btn-ticket:active{
  transform: translateY(0);
  box-shadow: inset 0 0 0 3px rgba(0,0,0,.08);
}

/* (Opcional) ajuste para dark mode si lo activas por clase .dark */
.dark .btn-ticket{
  --ink: var(--aw-color-text-default, #e5ecf6);
  box-shadow:
    0 8px 24px color-mix(in oklab, var(--primary), transparent 70%),
    inset 0 0 0 2px color-mix(in oklab, var(--primary), black 20%);
}
</style>
