<style is:inline>

  :root {

    /* -------------------------------
      FUENTES TIPOGRAFICAS
    ---------------------------------*/
    --aw-font-sans: 'Montserrat';
    --aw-font-serif: 'Montserrat';
    --aw-font-heading: 'weezerfont'; /* Headings */

    /* -------------------------------
      COLORES INSTITUCIONALES
     ---------------------------------*/
    --aw-color-primary: #01FFFF;       /* Textos */
    --aw-color-secondary:#FA119D;     /* Bordes */
    --aw-color-accent: #40F2FE;       /* Complemento al Primary color */
    --aw-color-emerald: #0b7069;      /* Verde esmeralda */

    /* -------------------------------
      COLORES COMPLEMENTARIOS
     ---------------------------------*/
    --aw-color-text-heading: #03292B;               /* Títulos en claro */
    --aw-color-text-default: #03292B;            /* Texto principal */
    --aw-color-text-muted: #03292B;                 /* Texto más suave */
    --aw-color-bg-page: rgb(255 255 255);       /* Fondo LandingPage */
    --aw-color-page-features2: #03292c;         /* Fondo sección Features2 - ¿Qué hacemos? */
    --aw-color-page-features2-dark: #021e22;    /* Fondo "tarjetas" Features2 - ¿Qué hacemos? */

  /* -------------------------------
    FUENTE PERSONALIZADA
  ---------------------------------*/
  @font-face {
    font-family: 'weezerfont';
    src: url('/fonts/weezerfont.ttf') format('truetype');
    font-weight: normal; /* Sólo soporta 400 */
    font-style: normal;
  }

}

</style>
