---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
---

<WidgetWrapper id="como-opera" classes={{ root: 'relative isolate' }} containerClass="max-w-7xl mx-auto">
  <!-- Barra superior -->
  <div class="h-1 w-3/4 sm:w-1/2 md:w-1/3 bg-[var(--aw-color-primary,#00cfe5)] mx-auto"></div>

  <section class="px-4 py-4 sm:py-8 md:py-6 text-center">
    <!-- menos padding -->
    <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-neutral-900">¿Cómo opera?</h2>

    <div class="mt-4 flex justify-center">
  <p class="text-base sm:text-lg leading-normal text-neutral-800 max-w-2xl">
    Evolv<span class="font-semibold">IA</span> funciona como una arquitectura cognitiva distribuida. 
    No se organiza por departamentos, sino por funciones simbióticas que operan como inteligencias activas,
    adaptativas y relacionales.
  </p>
</div>


    <p class="mt-10 text-2xl sm:text-4xl md:text-4xl font-semibold tracking-tight text-neutral-900">
      Estas funciones no son cargos.
    </p>
    <p class="mt-4 text-lg sm:text-xl text-neutral-700">Son presencias activas que co-diseñan contigo.</p>
  </section>
</WidgetWrapper>
